	select INGENIC_INTC
	select CLK_X1000
	select CLKSRC_OF
	select PINCTRL
	select BUILTIN_DTB
	select CLKDEV_LOOKUP
	select PINCTRL_INGENIC
	select CLKSRC_INGENIC_SYS_OST

config SOC_X1800
	bool "x1800 socs"
	select INGENIC_INTC
	select CLK_X1800
	select CLKSRC_OF
	select PINCTRL
	select BUILTIN_DTB
	select CLKDEV_LOOKUP
	select PINCTRL_INGENIC
	select PINCTRL_INGENIC_LEGACY_GPIO
	select CLKSRC_INGENIC_SYS_OST
	select XBURST_MXUV2

